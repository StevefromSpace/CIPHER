# Build output
/build/
/cmake-build-*/
/out/

# IDE/editor files
.vscode/
.idea/
*.user
*.suo

# Compiled files
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pdb

# Local-only configuration and logs
# cipher.conf is user-specific and must not be committed.
# cipher.conf.example IS committed (it contains no secrets).
cipher.conf
.env
.env.*
!.env.example
*.log

# Knowledge & Graph infrastructure (local-only)
graphify-out/
.agents/memory/

# Machine-specific agent configuration
.agents/mcp_config.json

# CIPHER Pipeline transient execution state and worktrees
.agents/pipeline/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Test fixtures, scratch, and temporary files
test_memory_tmp_dir/
test_cipher_config_tmp.conf
scratch/
*.tmp
