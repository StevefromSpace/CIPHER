# CIPHER configuration example
# ============================================================
# Copy this file to "cipher.conf" in the directory where you
# run CIPHER, then edit it as needed.
#
# Rules:
#   - Lines starting with '#' are comments (ignored).
#   - Blank lines are ignored.
#   - Each setting is:  key = value
#   - Whitespace around '=' is trimmed automatically.
#   - Unknown keys are rejected with an error message.
#   - CIPHER stops if the configuration file contains errors.
#     Fix the errors and restart.
#
# IMPORTANT: Do not store passwords, API keys, tokens, or any
# other secrets in this file.  This file may be committed to
# version control.  Keep secrets in environment variables or
# a separate secrets manager, not in cipher.conf.
# ============================================================


# ---------------------------------------------------------------------------
# log_level
#
# Controls the minimum severity of messages that are written to the log.
# Messages below this level are silently discarded.
#
# Allowed values (case-insensitive):
#   debug   — most verbose; prints internal state changes (use during development)
#   info    — normal operation events (default)
#   warn    — conditions that may indicate a problem but do not stop execution
#   error   — failures that prevented an operation from completing
#
# Default: info
# ---------------------------------------------------------------------------
log_level = info


# ---------------------------------------------------------------------------
# log_file
#
# Optional path to a log file.  CIPHER appends to this file on every run.
# If the path is relative, it is relative to the current working directory.
# If this setting is absent or empty, all log output goes to stderr only.
#
# Rotate or delete the file manually when it grows large.
# The file is created automatically on first use.
#
# Do not set this to a path inside the project repository unless you have
# also added the file to .gitignore.
#
# Default: (empty — stderr only)
# ---------------------------------------------------------------------------
# log_file = cipher.log


# ---------------------------------------------------------------------------
# memory_file
#
# Optional path to the persistent memory file. When set, CIPHER enables the
# remember, recall, forget, and memories commands. Each change is saved to
# this file immediately. The file is plain text and can be read or edited by
# hand.
#
# If the file exists but cannot be parsed, CIPHER stops at startup and does
# not overwrite it. A missing file starts an empty memory.
#
# Store only what you choose to remember. Do not store passwords, API keys,
# or tokens here.
#
# Do not set this to a path inside the project repository unless you have
# also added the file to .gitignore. Memory files hold personal data.
#
# Default: (empty — memory commands disabled)
# ---------------------------------------------------------------------------
# memory_file = cipher_memory.txt


# ---------------------------------------------------------------------------
# filesystem_read_root
#
# Optional folder that the owner-only `tool filesystem.read <relative path>`
# command may read from. Reads are read-only, limited to files under this
# folder, and capped at 64 KiB. Paths with `..`, absolute paths, symlinks,
# and junctions are refused. CIPHER's own memory file, log file, and
# cipher.conf are refused even when they sit under this folder.
#
# Do not point this at a folder that holds secrets (keys, tokens, password
# stores) or at your whole home directory.
#
# Default: (empty — filesystem.read not available)
# ---------------------------------------------------------------------------
# filesystem_read_root = C:/Users/you/Documents/notes

# ---------------------------------------------------------------------------
# ollama_port
#
# Optional port of a local Ollama server on 127.0.0.1. Enables the owner-typed
# `ask <question>` command. CIPHER only sends to 127.0.0.1 and refuses to send
# if the route is not verified local. Ask sends the typed text, plus a saved
# note only when you name it with `ask --memory <id>`.
# Set either ollama_port or llama_model_path, not both.
#
# Default: 0 (disabled)
# ---------------------------------------------------------------------------
# ollama_port = 11434

# ---------------------------------------------------------------------------
# llama_model_path
#
# Optional path of a local GGUF model file. `ask` then runs the model inside
# CIPHER through llama.cpp: no server, no network. CIPHER never downloads a
# model; you supply the file. Needs a build with -DCIPHER_WITH_LLAMA=ON.
# CIPHER refuses to start if the file is missing or not a valid GGUF model.
# Text only: the model is never offered tools (model_tool_calls is Ollama-only).
# Set either ollama_port or llama_model_path, not both.
#
# Default: (none, disabled)
# ---------------------------------------------------------------------------
# llama_model_path = C:/Users/you/models/qwen2.5-3b-instruct-q4_k_m.gguf

# ---------------------------------------------------------------------------
# llama_context_tokens, llama_max_output_tokens, llama_temperature
#
# Generation settings for llama_model_path (ignored without it).
#   llama_context_tokens    — context window in tokens; prompt and answer
#                             must fit in it. Larger values use more RAM.
#                             A whole number from 1 to 2147483647.
#   llama_max_output_tokens — most tokens one answer may generate. A whole
#                             number from 1 to 2147483647, and smaller than
#                             llama_context_tokens.
#   llama_temperature       — sampling randomness: 0 = greedy (the same
#                             answer every time), higher = more varied. Any
#                             finite number of 0 or more, written with '.'.
# A context too large for the machine's memory stops startup with an error.
#
# Defaults: 4096, 512, 0.8
# ---------------------------------------------------------------------------
# llama_context_tokens = 4096
# llama_max_output_tokens = 512
# llama_temperature = 0.8

# ---------------------------------------------------------------------------
# model_tool_calls
#
# true lets a model reply with `TOOL_CALL: time.now` or `TOOL_CALL: system.info`
# during `ask`. Each proposed call needs you to type exactly `yes`. Memory and
# file tools are never offered to the model. Effective only when ollama_port is set;
# ignored with llama_model_path.
#
# Default: false
# ---------------------------------------------------------------------------
# model_tool_calls = false

# ---------------------------------------------------------------------------
# memory_deny
#
# A pattern that refuses memory commands. Repeat the line for more patterns.
# A pattern is matched against "<action> <id>", the action alone, or "memory".
# Actions: remember, recall, forget, share (share = ask --memory).
# `*` works only at the start or end of a pattern.
#   memory_deny = share *     never send any memory to a model
#   memory_deny = *secret     refuse every action on the id "secret"
#
# Default: (none)
# ---------------------------------------------------------------------------
# memory_deny = share *
